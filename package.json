{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development npm run migrate:up && cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "cross-env NODE_ENV=production tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production npm run migrate:up && cross-env NODE_ENV=production node dist/server.js",
    "migrate:create": "cross-env NODE_ENV=development tsx scripts/migrate.ts create",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:up:dev": "cross-env NODE_ENV=development npm run migrate:up",
    "migrate:up:prod": "cross-env NODE_ENV=production npm run migrate:up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:down:dev": "cross-env NODE_ENV=development npm run migrate:down",
    "migrate:down:prod": "cross-env NODE_ENV=production npm run migrate:down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "migrate:status:dev": "cross-env NODE_ENV=development npm run migrate:status",
    "migrate:status:prod": "cross-env NODE_ENV=production npm run migrate:status"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
